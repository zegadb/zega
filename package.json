{
  "name": "zegadb",
  "version": "0.1.0",
  "description": "The Zega developer CLI: manage Zega Cloud from a terminal, a script or an agent.",
  "type": "module",
  "module": "src/zega.ts",
  "bin": {
    "zega": "src/zega.ts"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "start": "bun run ./src/zega.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "api:types": "openapi-typescript openapi/openapi.json -o src/types/cloud-api.d.ts",
    "build": "bun run scripts/build-all.ts",
    "api:update": "bun run scripts/update-api.ts",
    "explorer:update": "bun run scripts/update-explorer.ts"
  },
  "keywords": [
    "zega",
    "zegadb",
    "graph",
    "database",
    "cli"
  ],
  "author": "Sami Fouad",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "inquirer": "14.2.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
