# Files the formatter and its checks compare byte-for-byte stay LF on every
# checkout (Windows runners default to core.autocrlf=true): the syntax goldens,
# every ZQL/JSON file `zega-server fmt --check` walks, and the Markdown and explorer
# script whose embedded samples scripts/fmt-samples.py checks.
zega/src/fmt/goldens/** text eol=lf
*.zql text eol=lf
*.json text eol=lf
*.md text eol=lf
browser/repl.js text eol=lf

# Generated build output keeps its bytes (these override the rules above).
browser/pkg/** -text
browser/wasm-source.json -text
*.wasm binary

# .graph files are byte-exact (docs/graph-format.md); golden-v1.graph above all.
*.graph binary

# Data directories written by an older engine, read back as they are (#100).
zega/tests/fixtures/pre-100/**/*.bin binary
