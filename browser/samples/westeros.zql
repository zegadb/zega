// Held by: the well-documented span of a major seat's ruler.
mutation {
  Character(name: "Eddard Stark") {
    heldSeat -> link Location(name: "Winterfell") { &from: 283 &to: 298 }
  }
}

mutation {
  Character(name: "Robb Stark") {
    heldSeat -> link Location(name: "Winterfell") { &from: 298 &to: 299 }
  }
}

