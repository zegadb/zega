{
  "name": "zegadb",
  "version": "0.1.1",
  "private": true,
  "description": "The Zega developer CLI: manage Zega Cloud from a terminal, a script or an agent.",
  "type": "module",
  "module": "src/zega.ts",
  "bin": {
    "zega": "src/zega.ts"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zegadb/cli.git"
  },
  "homepage": "https://zega.dev",
  "optionalDependencies": {
    "@zegadb/server-darwin-arm64": "0.2.0",
    "@zegadb/server-darwin-x64": "0.2.0",
    "@zegadb/server-linux-x64": "0.2.0",
    "@zegadb/server-win32-x64": "0.2.0"
  },
  "scripts": {
    "start": "bun run ./src/zega.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 600000",
    "api:types": "openapi-typescript src/types/openapi.json -o src/types/cloud-api.d.ts",
    "build": "bun run scripts/build-all.ts",
    "api:update": "bun run scripts/update-api.ts",
    "explorer:update": "bun run scripts/update-explorer.ts",
    "docs:update": "bun run scripts/update-docs.ts"
  },
  "keywords": [
    "zega",
    "zegadb",
    "graph",
    "database",
    "cli"
  ],
  "author": "Sami Fouad",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "inquirer": "14.2.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
